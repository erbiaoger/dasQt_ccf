// DVV panel defaults persisted by the DVV GUI window.
{
    // Input source mode. Options: workspace, current_file.
    "file_source": "workspace",
    // Optional custom folder for DVV input; leave empty to use workspace.
    "data_folder": "/Volumes/SanDisk2T4/data/Ximen/2025-01-15",
    // If true, recursively scan supported DAS files in workspace subfolders.
    "workspace_recursive": false,
    // Legacy datetime start field kept for compatibility.
    "time_start": "2025-01-07",
    // Legacy datetime end field kept for compatibility.
    "time_end": "2025-02-18",
    // Date range start across files (inclusive). Supports date or datetime text.
    "date_start": "2025-01-07",
    // Date range end across files (inclusive). Supports date or datetime text.
    "date_end": "2025-02-18",
    // Daily time window start. Supports HH:MM[:SS], HHMM, HHMMSS.
    "day_time_start": "00:00:00",
    // Daily time window end. Supports HH:MM[:SS], HHMM, HHMMSS.
    "day_time_end": "23:59:59",
    // Minimum distance in meters used by CC extraction.
    "xmin": 100.0,
    // Maximum distance in meters used by CC extraction.
    "xmax": 150.0,
    // Virtual source channel index inside selected segment.
    "source_index": 0,
    // Reference strategy. Options: first, first_n_mean.
    "reference_mode": "first",
    // Reference trace count used when reference_mode is first_n_mean.
    "reference_count": 13,
    // Correlation selection. Options: ccf, acf, both.
    "correlation_mode": "acf",
    // CC method. Options: xcorr, coherency, deconv.
    "cc_method": "coherency",
    // Stacking method for CC chunks. Options: pws, linear, robust.
    "stacking_method": "pws",
    // Frequency normalization mode.
    "freq_norm": "phase_only",
    // Time normalization mode.
    "time_norm": "one_bit",
    // CC minimum frequency in Hz.
    "freqmin": 2.0,
    // CC maximum frequency in Hz.
    "freqmax": 20.0,
    // Maximum lag in seconds retained in CC gather.
    "maxlag": 10.0,
    // CC chunk length in seconds.
    "cc_len": 20.0,
    // Enable FK filtering before CC if true.
    "fk_enabled": false,
    // FK filter minimum velocity in m/s.
    "fk_cmin": 10.0,
    // FK filter maximum velocity in m/s.
    "fk_cmax": 1200.0,
    // FK direction. Options: both, pos, neg.
    "fk_sgn": "both",
    // DVV estimator. Options: mwcs, wxspectrum, wxs_wavelet, vmd_hht.
    "method": "wxs_wavelet",
    // MWCS moving window length in seconds.
    "mwcs_window_s": 0.25,
    // MWCS moving window step in seconds.
    "mwcs_step_s": 0.05,
    // MWCS regression minimum frequency in Hz.
    "mwcs_fmin": 2.0,
    // MWCS regression maximum frequency in Hz.
    "mwcs_fmax": 12.0,
    // WXSpectrum minimum stretch (fraction).
    "stretch_min": -0.01,
    // WXSpectrum maximum stretch (fraction).
    "stretch_max": 0.01,
    // Number of stretch candidates for WXSpectrum.
    "stretch_steps": 81,
    // Wavelet/VMD lag window lower bound in seconds.
    "lag_min_s": 5.0,
    // Wavelet/VMD lag window upper bound in seconds.
    "lag_max_s": 7.0,
    // Wavelet family. Options: amor, morse, bump.
    "wx_wavelet": "amor",
    // Wavelet frequency resolution (voices per octave).
    "wx_voices_per_octave": 10,
    // Enable 2D smoothing on wavelet cross-spectrum.
    "wx_smoothing": true,
    // Wavelet scale-direction smoothing size.
    "wx_ns": 3,
    // Wavelet time-direction Gaussian smoothing factor.
    "wx_nt": 0.25,
    // Amplitude threshold used when selecting wavelet ROI.
    "wx_amp_thresh": 0.0,
    // VMD-HHT mode. Options: acf, coda.
    "vmd_mode": "coda",
    // VMD number of modes.
    "vmd_k": 4,
    // VMD bandwidth penalty alpha.
    "vmd_alpha": 1000.0,
    // HHT smoothing window in cycles.
    "vmd_n_cycles": 3.0,
    // Low-amplitude percentile used for phase unwrap protection.
    "vmd_amp_percentile": 5.0,
    // Sigma-clipping multiplier for scalar dv/v extraction.
    "vmd_sigma_clip": 3.0,
    // Maximum allowed |dv/v| percent per IMF candidate.
    "vmd_dvv_abs_max": 2.0,
    // Minimum IMF coherency threshold.
    "vmd_coherency_min": 0.85,
    // Zero-lag mute end time in seconds (acf mode).
    "vmd_mute_end_s": 3.0,
    // Zero-lag mute taper length in seconds (acf mode).
    "vmd_taper_len_s": 2.0,
    // Quality cutoff used to flag accepted solutions.
    "quality_threshold": 0.5
}
