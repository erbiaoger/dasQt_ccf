// Legacy nested dispersion workflow config. This file is still used by GUI display-state persistence and older scripts.
{
    // Cross-correlation settings.
    "CC": {
        // Preprocessing options applied before correlation.
        "filter": {
            // Band-pass minimum frequency in Hz.
            "fmin": 3.0,
            // Band-pass maximum frequency in Hz.
            "fmax": 30.0,
            // Frequency normalization. Options: no, rma, phase_only.
            "freq_norm": "phase_only",
            // Time normalization. Options: no, rma, one_bit.
            "time_norm": "one_bit",
            // Correlation method. Options: coherency, xcorr, deconv.
            "cc_method": "xcorr"
        },
        // Smoothing and lag controls.
        "smooth": {
            // Time-domain smoothing length.
            "smooth_N": 5,
            // Spectral smoothing length.
            "smoothspect_N": 5,
            // Maximum lag in seconds for the final gather.
            "maxlag": 1.8
        },
        // Shot/segment geometry for CC computation.
        "cc": {
            // Window length in seconds for each CC chunk.
            "CC_len": 4.0,
            // Minimum distance of the segment in meters.
            "Xmin": 5330.0,
            // Maximum distance of the segment in meters.
            "Xmax": 6330.0,
            // Virtual source index or source-channel selector used by legacy workflows.
            "Shot": 50,
            // Stacking method. Options: linear, pws, robust.
            "Smethod": "pws"
        },
        // How many files the legacy 'read more' action stacks together.
        "next_data": 18,
        // Default output folder for saved CC results.
        "cc_path": "/Volumes/SanDisk2T/untitled folder"
    },
    // Dispersion analysis settings.
    "disp": {
        // Frequency/velocity scan grid.
        "par": {
            // Minimum phase velocity in m/s.
            "Cmin": 400.0,
            // Maximum phase velocity in m/s.
            "Cmax": 1500.0,
            // Velocity step in m/s.
            "dc": 1.0,
            // Minimum dispersion frequency in Hz.
            "fmin": 3.0,
            // Maximum dispersion frequency in Hz.
            "fmax": 30.0,
            // Frequency step in Hz.
            "df": 0.1
        },
        // Automatic curve-picking thresholds.
        "curve": {
            // Spatial decimation used during curve extraction.
            "skip_Nch": 5,
            // Temporal/frequency decimation used during curve extraction.
            "skip_Nt": 1,
            // Normalized amplitude threshold used by auto picking.
            "threshold": 0.9,
            // Maximum number of modes to keep.
            "maxMode": 5,
            // Minimum number of connected pixels / carriers required for a mode.
            "minCarNum": 5
        },
        // All-shot geometry in meters.
        "multiple_shot": {
            // Shot spacing in meters.
            "dshot": 10.0,
            // Receiver window length from each shot in meters.
            "offset": 40.0
        }
    }
}
