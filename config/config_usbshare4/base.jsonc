// Main GUI defaults loaded at startup. Modify these values to change the default display state.
{
    // Global figure rendering defaults.
    "figure": {
        // Matplotlib colormap name. Common choices: RdBu, rainbow, viridis, seismic, gray.
        "colormap": "RdBu",
        // Display amplitude scaling factor used by the main image view.
        "scale": 1.5
    },
    // Initial spatial window in meters.
    "data": {
        // Default minimum distance shown after opening a file.
        "xmin": 125.0,
        // Default maximum distance shown after opening a file.
        "xmax": 200.0,
        // Default display duration in seconds used by some example workflows.
        "display_t": 60.0,
        // Initial animation-speed multiplier used by some example workflows.
        "animation_speed": 10.0,
        // Default distance-axis downsample factor for examples.
        "distance_downsample": 1,
        // Default time-axis downsample factor for examples.
        "time_downsample": 1
    },
    // Frequency panel defaults.
    "freq": {
        // Default trace position in meters for spectrum-like views.
        "trace": 160.0,
        // Upper frequency limit in Hz used by the frequency display.
        "end_freq": 200.0,
        // How many files to advance when the UI runs a batch-style next-data action.
        "next_data": 5,
        // Display scale multiplier for frequency-domain plots.
        "scale": 1
    },
    // Band-pass denoise defaults.
    "denoise": {
        // Lower corner frequency in Hz.
        "fmin": 2.0,
        // Upper corner frequency in Hz.
        "fmax": 50.0,
        // Filter order.
        "order": 5
    },
    // Logging defaults.
    "logging": {
        // Logger level. Common values: DEBUG, INFO, WARNING, ERROR.
        "level": "INFO"
    },
    // Shot Extract panel defaults persisted by the main GUI.
    "shot_extract": {
        // Minimum peak-to-peak spacing in seconds.
        "event_gap_s": 2.0,
        // Shot window length in seconds.
        "window_s": 1.0,
        // Sliding step in seconds used during scanning.
        "slide_step_s": 0.1,
        // Alignment mode. Options: onset_preroll, onset_preroll_xcorr.
        "align_mode": "onset_preroll_xcorr",
        // Pre-roll duration in seconds.
        "pre_roll_s": 0.1,
        "sta_window_s": 0.199,
        "lta_window_s": 10.0,
        // Detection reference channel position in meters.
        "detect_channel_m": 130.0,
        // If true, normalize traces before peak/event detection.
        "normalize_trace_detect": false,
        // If true, normalize traces when plotting shot previews.
        "normalize_trace_plot": true,
        // If true, cross-correlation alignment uses all channels.
        "xcorr_use_all_channels": true,
        "shot_save_root": "/Users/zhangzhiyu/Desktop/Shots/02",
        "stack_output_subdir": "stack_results",
        "stack_max_shift_ms": 80.0,
        "stack_event_threshold_ratio": 0.35,
        "stack_min_event_ms": 120.0,
        "stack_outlier_min_score": 0.35,
        "stack_apply_bandpass": true,
        "stack_bandpass_low_hz": 2.0,
        "stack_bandpass_high_hz": 50.0,
        // Default shot-root folder used by 'Import Stacked .mat'.
        "stack_import_root": ""
    }
}
