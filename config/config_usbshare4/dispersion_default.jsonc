// Reference dispersion template kept in the package.
{
    // Legacy cross-correlation defaults.
    "CC": {
        "filter": {
            // Band-pass minimum frequency in Hz.
            "fmin": 2.0,
            // Band-pass maximum frequency in Hz.
            "fmax": 30.0,
            // Frequency normalization. Options: no, rma, phase_only.
            "freq_norm": "rma",
            // Time normalization. Options: no, rma, one_bit.
            "time_norm": "no",
            // Correlation method. Options: coherency, xcorr, deconv.
            "cc_method": "coherency"
        },
        "smooth": {
            // Time-domain smoothing length.
            "smooth_N": 10,
            // Spectral smoothing length.
            "smoothspect_N": 10,
            // Maximum lag in seconds.
            "maxlag": 1.0
        },
        "cc": {
            // Window length in seconds per CC chunk.
            "CC_len": 6,
            // Minimum distance in meters.
            "Xmin": 100.0,
            // Maximum distance in meters.
            "Xmax": 300.0,
            // Legacy source selector.
            "Shot": 100,
            // Stacking method. Options: linear, pws, robust.
            "Smethod": "pws"
        },
        // How many input files to stack in one batch.
        "next_data": 3,
        // Legacy embedded dispersion scan parameters.
        "dispersion": {
            // Minimum phase velocity in m/s.
            "Cmin": 10.0,
            // Maximum phase velocity in m/s.
            "Cmax": 600.0,
            // Velocity step in m/s.
            "dc": 1.0,
            // Minimum dispersion frequency in Hz.
            "fmin": 3.0,
            // Maximum dispersion frequency in Hz.
            "fmax": 20.0,
            // Frequency step in Hz.
            "df": 0.1
        },
        "curve": {
            // Spatial decimation used during curve extraction.
            "skip_Nch": 5,
            // Temporal/frequency decimation used during curve extraction.
            "skip_Nt": 1,
            // Normalized amplitude threshold for auto picking.
            "threshold": 0.9,
            // Maximum number of modes to keep.
            "maxMode": 10,
            // Minimum number of connected carriers required.
            "minCarNum": 40
        },
        "multiple_shot": {
            // Shot spacing in meters or channels depending on the caller.
            "dshot": 20,
            // Receiver window length in meters or channels depending on the caller.
            "offset": 50
        }
    }
}
