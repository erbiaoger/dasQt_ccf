// Session state saved by the legacy dispersion / COG / beamforming windows.
{
    // Cross-correlation parameters actually used in the current session.
    "cc": {
        // Sampling rate in Hz.
        "sps": 500.0,
        // Sampling rate in Hz. Kept for backward compatibility.
        "samp_freq": 500.0,
        // Current shot index/source selector.
        "ishot_inf": 50,
        // Minimum frequency in Hz.
        "freqmin": 4.0,
        // Maximum frequency in Hz.
        "freqmax": 10.0,
        // Frequency normalization. Options: no, rma, phase_only.
        "freq_norm": "phase_only",
        // Time normalization. Options: no, rma, one_bit.
        "time_norm": "one_bit",
        // Correlation method. Options: coherency, xcorr, deconv.
        "cc_method": "xcorr",
        // Time-domain smoothing length.
        "smooth_N": 5,
        // Spectral smoothing length.
        "smoothspect_N": 5,
        // Maximum lag in seconds.
        "maxlag": 1.8,
        // Channel-quality threshold.
        "max_over_std": 1000000000,
        // Window length in seconds.
        "cc_len": 4.0,
        // Segment minimum distance or channel index.
        "cha1": 5330.0,
        // Segment maximum distance or channel index.
        "cha2": 6330.0,
        // Output folder.
        "cc_path": "/Volumes/SanDisk2T/untitled folder"
    },
    // Dispersion scan grid used in the current session.
    "disp": {
        // Minimum phase velocity in m/s.
        "cmin": 10.0,
        // Maximum phase velocity in m/s.
        "cmax": 800.0,
        // Velocity step in m/s.
        "dc": 1.0,
        // Minimum frequency in Hz.
        "fmin": 3.0,
        // Maximum frequency in Hz.
        "fmax": 30.0,
        // Frequency step in Hz.
        "df": 0.1
    },
    // Derived shot geometry from the current session.
    "shot": {
        // Shot position in meters.
        "x_shot": 130.0,
        // Shot index used by the legacy workflow.
        "ishot_inf": 50,
        // Segment minimum channel index.
        "i_xmin": 533,
        // Segment maximum channel index.
        "i_xmax": 633,
        // Shot spacing in channels.
        "i_dshot": 24,
        // All extracted shot indices.
        "i_shots_inf": [],
        // All extracted shot positions in meters.
        "x_shots": [],
        // Per-shot start channel indices.
        "i_cha1s": [],
        // Per-shot end channel indices.
        "i_cha2s": [],
        // Current shot-window start distance in meters.
        "cha1": 223.94041442871094,
        // Current shot-window end distance in meters.
        "cha2": 300.0,
        // Current shot-window start channel index.
        "i_cha1": 64,
        // Current shot-window end channel index.
        "i_cha2": 88
    },
    // Saved mute polygons / picked points.
    "point": {
        // Mute polygon points for the up-going branch.
        "mute_up": [],
        // Mute polygon points for the down-going branch.
        "mute_down": []
    },
    // Mute-line helper parameters.
    "mute": {
        // Minimum mute velocity or slope helper.
        "vmin": 0.009313286411764984,
        // Intercept/helper constant used by the legacy mute tool.
        "const2": 0.046899845916795115
    },
    // Side selector for muted CC/dispersion. Common values: left, right.
    "which": "right",
    // Current GUI indices.
    "index": {
        // Current click index.
        "click": 77,
        // Current all-shot index.
        "shot": 0
    }
}
